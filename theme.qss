QWidget { background: #11161f; color: #e9edf5; font-family: 'Segoe UI'; font-size: 13px; }
QMainWindow, QDialog { background: #11161f; }
QFrame#sidebar { background: #0d1119; border-right: 1px solid #252d3a; }
QFrame#sidebar QLabel, QFrame#sidebar QWidget { background: transparent; }
QLabel#brand { color: #c5f0b8; font-size: 22px; font-weight: 800; letter-spacing: 1px; }
QLabel#eyebrow { color: #91a295; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
QLabel#title { font-size: 30px; font-weight: 700; }
QLabel#section { font-size: 18px; font-weight: 650; }
QLabel#muted { color: #99a6ba; }
QLabel#small { color: #99a6ba; font-size: 11px; }
QLabel#cardDescription { color: #c7cfdb; font-size: 11px; line-height: 1.35; }
QLabel#badge { background: #22372c; color: #b6e7aa; border-radius: 5px; padding: 5px 8px; font-size: 10px; font-weight: 700; }
QLabel#pending { background: #282b37; color: #c0bdd0; border-radius: 5px; padding: 5px 8px; font-size: 10px; font-weight: 700; }
QLabel#warning { background: #332d22; color: #eed6a7; padding: 12px; border: 1px solid #655038; border-radius: 8px; }
QLabel#success { color: #b6e7aa; }
QFrame#card { background: #191f2a; border: 1px solid #303848; border-radius: 12px; }
QFrame#card QLabel, QFrame#card QWidget { background: transparent; }
QFrame#panel { background: #191f2a; border: 1px solid #303848; border-radius: 10px; }
QFrame#panel QLabel { background: transparent; border: none; }
QFrame#topbar { border-bottom: 1px solid #293241; }
QFrame#field { border-bottom: 1px solid #28313f; }
QPushButton { background: #222b3a; border: 1px solid #364154; border-radius: 7px; padding: 10px 15px; font-weight: 600; }
QPushButton:hover { background: #2d3a4d; border-color: #657b91; }
QPushButton:pressed { background: #17202c; }
QPushButton:focus { border: 1px solid #c5f0b8; }
QPushButton:disabled { color: #697688; background: #1d2430; border-color: #29313e; }
QPushButton#primary { background: #b6e7aa; color: #14251c; border: 1px solid #b6e7aa; }
QPushButton#primary:hover { background: #cef5c6; }
QPushButton#primary:disabled { background: #334638; color: #718374; border-color: #334638; }
QPushButton#nav { background: transparent; border: none; text-align: left; padding: 13px 16px; color: #9daac0; }
QPushButton#nav:checked { background: #23312c; color: #c5f0b8; }
QPushButton#nav:hover { background: #202735; }
QPushButton#filter { background: transparent; color: #a8b4c7; border-color: #303b4c; padding: 7px 14px; }
QPushButton#filter:checked { color: #d3edcd; background: #24342c; border-color: #6d8e71; }
QLineEdit, QComboBox { background: #151c27; border: 1px solid #39465a; border-radius: 7px; padding: 10px; selection-background-color: #49664b; }
QLineEdit:focus, QComboBox:focus { border-color: #b6e7aa; }
QLineEdit[invalid="true"] { border-color: #e49591; background: #302227; }
QLineEdit[changed="true"] { color: #c5f0b8; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { background: #202a38; selection-background-color: #344f43; color: #edf3f5; border: 1px solid #45556a; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 8px; background: #121923; margin: 0; }
QScrollBar::handle:vertical { background: #3d4c61; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QTabWidget::pane { border: none; border-top: 1px solid #354052; padding-top: 15px; }
QTabBar::tab { background: transparent; padding: 11px 16px; color: #a4b1c5; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #c5f0b8; border-bottom-color: #b6e7aa; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #6e8299; border-radius: 3px; background: #17202c; }
QCheckBox::indicator:checked { background: #b6e7aa; border: 3px solid #324d36; }
QToolTip { background: #263448; color: #edf3f5; border: 1px solid #526784; padding: 7px; }
QStatusBar { border-top: 1px solid #293241; color: #9daac0; font-size: 11px; }
QTextEdit { background: #151c27; border: 1px solid #344155; border-radius: 8px; padding: 12px; }
