QWidget { background: #0e1725; color: #e7eeff; font-family: 'Segoe UI'; font-size: 13px; }
QMainWindow, QDialog { background: #0e1725; }
QFrame#sidebar { background: #0b1422; border-right: 1px solid #252d3a; }
QFrame#sidebar QLabel, QFrame#sidebar QWidget { background: transparent; }
QLabel#brand { color: #8bbcff; font-size: 22px; font-weight: 800; letter-spacing: 1px; }
QLabel#eyebrow { color: #91a295; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
QLabel#title { font-size: 30px; font-weight: 700; }
QLabel#section { font-size: 18px; font-weight: 650; }
QLabel#muted { color: #99a6ba; }
QLabel#small { color: #99a6ba; font-size: 11px; }
QLabel#cardDescription { color: #c7cfdb; font-size: 11px; line-height: 1.35; }
QLabel#badge { background: #1b426a; color: #83b6ff; border-radius: 5px; padding: 5px 8px; font-size: 10px; font-weight: 700; }
QLabel#pending { background: #282b37; color: #c0bdd0; border-radius: 5px; padding: 5px 8px; font-size: 10px; font-weight: 700; }
QLabel#warning { background: #332d22; color: #eed6a7; padding: 12px; border: 1px solid #655038; border-radius: 8px; }
QLabel#success { color: #83b6ff; }
QFrame#card { background: #172536; border: 1px solid #2b405b; border-radius: 12px; }
QFrame#card QLabel, QFrame#card QWidget { background: transparent; }
QFrame#panel { background: #172536; border: 1px solid #2b405b; border-radius: 10px; }
QFrame#panel QLabel { background: transparent; border: none; }
QFrame#topbar { border-bottom: 1px solid #293241; }
QFrame#field { border-bottom: 1px solid #28313f; }
QPushButton { background: #223650; border: 1px solid #364154; border-radius: 7px; padding: 10px 15px; font-weight: 600; }
QPushButton:hover { background: #2b4668; border-color: #657b91; }
QPushButton:pressed { background: #17202c; }
QPushButton:focus { border: 1px solid #8bbcff; }
QPushButton:disabled { color: #697688; background: #1d2430; border-color: #29313e; }
QPushButton#primary { background: #83b6ff; color: #07192c; border: 1px solid #83b6ff; }
QPushButton#primary:hover { background: #b3d3ff; }
QPushButton#primary:disabled { background: #24456a; color: #789dc7; border-color: #24456a; }
QPushButton#nav { background: transparent; border: none; text-align: left; padding: 13px 16px; color: #9daac0; }
QPushButton#nav:checked { background: #1c3e6a; color: #8bbcff; }
QPushButton#nav:hover { background: #202735; }
QPushButton#filter { background: transparent; color: #a8b4c7; border-color: #303b4c; padding: 7px 14px; }
QPushButton#filter:checked { color: #cfe3ff; background: #1b3555; border-color: #3985ec; }
QLineEdit, QComboBox { background: #101e30; border: 1px solid #39465a; border-radius: 7px; padding: 10px; selection-background-color: #235c9b; }
QLineEdit:focus, QComboBox:focus { border-color: #83b6ff; }
QLineEdit[invalid="true"] { border-color: #e49591; background: #302227; }
QLineEdit[changed="true"] { color: #8bbcff; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { background: #202a38; selection-background-color: #344f43; color: #edf3f5; border: 1px solid #45556a; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 8px; background: #121923; margin: 0; }
QScrollBar::handle:vertical { background: #3d4c61; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QTabWidget::pane { border: none; border-top: 1px solid #354052; padding-top: 15px; }
QTabBar::tab { background: transparent; padding: 11px 16px; color: #a4b1c5; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #8bbcff; border-bottom-color: #83b6ff; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #6e8299; border-radius: 3px; background: #17202c; }
QCheckBox::indicator:checked { background: #83b6ff; border: 3px solid #275aa1; }
QToolTip { background: #263448; color: #edf3f5; border: 1px solid #526784; padding: 7px; }
QStatusBar { border-top: 1px solid #293241; color: #9daac0; font-size: 11px; }
QTextEdit { background: #101e30; border: 1px solid #344155; border-radius: 8px; padding: 12px; }

/* Save Data visual refresh: selectable covers and inspector */
QFrame#inspector { background: #152335; border: 1px solid #2b405b; border-radius: 13px; }
QFrame#inspector QLabel { background: transparent; border: none; }
QLabel#cardTitle { font-size: 14px; font-weight: 700; color: #f1f6ff; }
QFrame#card[selected="true"] { border: 2px solid #308aff; background: #18304b; }
QPushButton#fileChoice { text-align: left; padding: 10px 8px; background: #1c2d43; font-size: 11px; }
QPushButton#fileChoice[selected="true"] { border-color: #348bff; color: #d1e7ff; }
QLabel#backupEntry { background: #192d43; border: 1px solid #2c4158; border-radius: 7px; padding: 8px; color: #dce8f7; font-size: 11px; }
QPushButton#backupAction { background: #14684e; border-color: #1b8b66; color: #f0fff8; }
QPushButton#backupAction:hover { background: #168c66; }
QPushButton#restoreAction { background: #26589b; border-color: #347bd5; color: #edf5ff; }
QPushButton#restoreAction:hover { background: #3675bb; }
QPushButton#cardAction { background: #214f82; border: 1px solid #316fa8; }
