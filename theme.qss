QWidget { background: @canvas@; color: @text@; font-family: 'Segoe UI Variable', 'Segoe UI'; font-size: 13px; }
QLabel { background: transparent; }
QMainWindow, QDialog { background: @canvas@; }
QFrame#appHeader { background: @surface@; border-bottom: 1px solid @line@; }
QFrame#appHeader QLabel { background: transparent; }
QFrame#sidebar { background: @sidebar@; border-right: 1px solid @line@; }
QFrame#sidebar QLabel, QFrame#sidebar QWidget { background: transparent; }
QLabel#brand { color: @text@; font-size: 22px; font-weight: 600; }
QLabel#eyebrow { color: @muted@; font-size: 11px; font-weight: 600; }
QLabel#libraryTitle { color: @text@; font-size: 23px; font-weight: 600; }
QLabel#title { font-size: 28px; font-weight: 600; }
QLabel#section { font-size: 18px; font-weight: 600; }
QLabel#detailTitle { font-size: 21px; font-weight: 600; }
QLabel#cardTitle { color: @text@; font-size: 13px; font-weight: 600; }
QLabel#cardPlatform { color: @secondary@; font-size: 11px; }
QLabel#muted { color: @secondary@; }
QLabel#small { color: @muted@; font-size: 11px; }
QLabel#headerStatus { color: @muted@; font-size: 11px; }
QLabel#readyStatus { color: @success@; font-size: 11px; }
QLabel#detailDescription { color: @secondary@; }
QLabel#saveName, QLabel#summaryName { color: @text@; font-size: 12px; font-weight: 600; }
QLabel#badge { background: @selection@; color: @selectionText@; border-radius: 8px; padding: 5px 9px; font-size: 10px; font-weight: 600; }
QLabel#pending { background: @input@; color: @secondary@; border-radius: 8px; padding: 5px 9px; font-size: 10px; font-weight: 600; }
QLabel#experimental { background: @warningSurface@; color: @warningText@; border-radius: 8px; padding: 5px 9px; font-size: 10px; font-weight: 600; }
QLabel#info { background: @infoSurface@; color: @infoText@; border: 1px solid @infoLine@; border-radius: 10px; padding: 10px; font-size: 11px; }
QLabel#fieldError { color: @error@; font-size: 11px; }
QLabel#warning { background: @warningSurface@; color: @warningText@; padding: 12px; border: 1px solid @warningLine@; border-radius: 10px; }
QLabel#success { color: @success@; }
QFrame#libraryPanel { background: @canvas@; border: none; border-radius: 16px; }
QFrame#detailPanel, QFrame#panel { background: @surface@; border: 1px solid @line@; border-radius: 16px; }
QWidget#clearSurface { background: transparent; }
QFrame#gameCard { background: @surface@; border: 2px solid @surface@; border-radius: 12px; }
QFrame#gameCard:hover { background: @hover@; border-color: @hover@; }
QFrame#gameCard:focus { border-color: @accent@; }
QFrame#gameCard[selected="true"] { background: @selection@; border-color: @accent@; }
QFrame#gameCard QLabel, QFrame#gameCard QWidget { background: transparent; }
QFrame#coverFrame { background: transparent; border: none; border-radius: 8px; }
QFrame#saveRow { background: @input@; border: none; border-radius: 10px; }
QFrame#divider { background: @line@; border: none; }
QFrame#field { background: transparent; border: none; border-bottom: 1px solid @line@; }
QFrame#editorSection { border: 1px solid @line@; border-radius: 14px; background: @surface@; }
QFrame#editorSection QLineEdit, QFrame#editorSection QComboBox { background: @input@; }
QPushButton#sectionToggle { text-align: left; background: transparent; border: none; padding: 8px 10px; color: @secondary@; }
QPushButton#sectionToggle:hover { background: @input@; }
QPushButton { background: @surface@; border: 1px solid @line@; border-radius: 10px; padding: 10px 15px; font-weight: 600; }
QPushButton:hover { background: @hover@; }
QPushButton:pressed { background: @input@; }
QPushButton:focus { border-color: @accent@; }
QPushButton:disabled { color: @disabledText@; background: @disabledSurface@; border-color: @disabledSurface@; }
QPushButton#primary { background: @accent@; color: #FFFFFF; border: 1px solid @accent@; }
QPushButton#primary:hover { background: @accentHover@; border-color: @accentHover@; }
QPushButton#primary:disabled { background: @disabledSurface@; color: @disabledText@; border-color: @disabledSurface@; }
QPushButton#nav { background: transparent; border: none; text-align: left; padding: 12px 16px; color: @secondary@; }
QPushButton#nav:checked { background: @selection@; color: @selectionText@; }
QPushButton#nav:hover { background: @hover@; }
QPushButton#appearanceToggle { background: @input@; border: none; padding: 8px 12px; }
QPushButton#iconButton { min-width: 18px; padding: 10px 12px; font-size: 17px; }
QPushButton#rowMenu { background: transparent; border: none; padding: 6px; min-width: 24px; }
QPushButton#fieldReset { background: transparent; padding: 5px 7px; min-width: 16px; color: @accent@; border-color: transparent; }
QPushButton#fieldReset:hover { background: @selection@; }
QPushButton#fieldReset:disabled { color: @disabledText@; }
QPushButton#saveLink { background: transparent; border: none; padding: 2px 0; text-align: left; color: @text@; }
QPushButton#saveLink:hover { color: @accent@; }
QLineEdit, QComboBox { background: @input@; border: 1px solid @line@; border-radius: 10px; padding: 10px; selection-background-color: @accent@; selection-color: #FFFFFF; }
QLineEdit:focus, QComboBox:focus { border-color: @accent@; }
QLineEdit[changed="true"] { color: @success@; }
QLineEdit[invalid="true"] { color: @error@; border-color: @error@; background: @invalidSurface@; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { background: @surface@; selection-background-color: @selection@; selection-color: @text@; color: @text@; border: 1px solid @line@; padding: 4px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 7px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: @scroll@; border-radius: 3px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QTabWidget::pane { border: none; padding-top: 12px; }
QTabBar::tab { background: @input@; padding: 9px 18px; color: @secondary@; border: 1px solid transparent; border-radius: 9px; margin: 2px; }
QTabBar::tab:selected { background: @surface@; color: @accent@; border-color: @line@; font-weight: 600; }
QTabWidget#editorCategories::pane { border: none; padding-top: 18px; }
QTabWidget#editorCategories QTabBar::tab { padding: 11px 24px; margin: 0 8px 0 0; border-radius: 12px; background: @input@; font-weight: 600; }
QTabWidget#editorCategories QTabBar::tab:selected { background: @selection@; color: @selectionText@; border-color: @selection@; }
QTabWidget#editorCategories QTabBar::tab:hover { background: @hover@; }
QWidget#categoryWorkspace { background: transparent; }
QFrame#sectionSidebar { background: @surface@; border: 1px solid @line@; border-radius: 16px; }
QLabel#navigationCaption { padding: 3px 8px 10px; color: @muted@; font-size: 10px; font-weight: 600; }
QListWidget#sectionNavigation { background: transparent; border: none; outline: none; padding: 0; }
QListWidget#sectionNavigation::item { color: @secondary@; padding: 12px 10px; border-radius: 10px; margin: 2px 0; }
QListWidget#sectionNavigation::item:hover { background: @hover@; }
QListWidget#sectionNavigation::item:selected { background: @selection@; color: @selectionText@; font-weight: 600; }
QListWidget#sectionNavigation:disabled { color: @disabledText@; }
QLabel#editorBreadcrumb { color: @muted@; font-size: 11px; }
QLabel#editorSectionTitle { font-size: 24px; font-weight: 600; }
QPushButton#characterChip { background: @input@; border-color: transparent; border-radius: 11px; padding: 9px 18px; }
QPushButton#characterChip:checked { background: @selection@; color: @selectionText@; }
QPushButton#characterChip:hover { background: @hover@; }
QScrollArea#characterStrip, QScrollArea#editorFieldsScroll, QScrollArea#editorFieldsScroll > QWidget { background: transparent; }
QFrame#editorFooter { background: @surface@; border: 1px solid @line@; border-radius: 16px; }
QFrame#editorFooter QLabel { background: transparent; }
QLabel#pendingCount { font-size: 14px; font-weight: 600; color: @selectionText@; }
QPushButton#editorReset { background: transparent; border-color: transparent; color: @secondary@; }
QPushButton#editorReset:hover { background: @input@; }
QFrame#saveDetails { background: @surface@; border: 1px solid @line@; border-radius: 14px; }
QFrame#saveDetails QLabel { background: transparent; }
QFrame#field QLabel { background: transparent; }
QFrame#field:hover { background: @input@; border-radius: 10px; }
QFrame#editorSection { border: none; border-radius: 16px; background: @surface@; }
QPushButton#sectionToggle { padding: 5px 8px 8px; font-size: 12px; font-weight: 600; }
QLineEdit#fieldSearch, QLineEdit#editorSearch { padding: 11px 14px; }
QPushButton#editorBack { text-align: left; color: @accent@; padding: 0; border: none; background: transparent; font-size: 12px; }
QWidget#attributeGrid { background: transparent; }
QComboBox[changed="true"], QCheckBox[changed="true"] { color: @success@; }
QCheckBox { background: transparent; spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid @muted@; border-radius: 5px; background: @surface@; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; image: url("@checkIcon@"); }
QToolTip { background: @surface@; color: @text@; border: 1px solid @line@; padding: 8px; }
QLabel#itemSprite { background: #242426; border: 1px solid @line@; border-radius: 12px; }
QStatusBar { background: @canvas@; border-top: 1px solid @line@; color: @muted@; font-size: 11px; }
QTextEdit { background: @surface@; border: 1px solid @line@; border-radius: 12px; padding: 12px; }
